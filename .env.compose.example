# Docker Compose Environment Configuration
# Copy this to .env and adjust paths as needed

# Configuration directory (application config, .env file)
# Default: ./config
# For persistent storage:
#   CONFIG_PATH=/mnt/user/appdata/newznab/config
#   CONFIG_PATH=/var/lib/newznab-tmux/config
CONFIG_PATH=./config

# Storage directory (Usenet headers, metadata, NZB files)
# Default: ./storage
# For persistent storage:
#   STORAGE_PATH=/mnt/user/appdata/newznab/storage
#   STORAGE_PATH=/var/lib/newznab-tmux/storage
STORAGE_PATH=./storage

# Data directory (database, cache, search index)
# Default: ./data
# For persistent storage:
#   DATA_PATH=/mnt/user/appdata/newznab/data
#   DATA_PATH=/var/lib/newznab-tmux/data
DATA_PATH=./data

# Web interface port
WEB_PORT=8080

# PHP configuration
PHP_MEMORY_LIMIT=2048M
PHP_MAX_EXECUTION_TIME=300

# Meilisearch API key (auto-generated if not set, but can be pre-configured)
MEILISEARCH_KEY=changeme
