# Docker Compose Environment Configuration
# Copy this to .env and adjust paths as needed

# Application data directory (config, .env, storage, bootstrap cache)
# Container structure:
#   /config/.env                    → .env file
#   /config/storage/                → Usenet headers, metadata
#   /config/storage/nzbs/           → Downloaded NZB files
#   /config/bootstrap-cache/        → Laravel cache
# Default: ./appdata
# For persistent storage:
#   APPDATA_PATH=/mnt/user/appdata/newznab
#   APPDATA_PATH=/var/lib/newznab-tmux
APPDATA_PATH=./appdata

# Persistent service data directory (database, cache, search index, logs)
# Container structure:
#   /data/mysql/        → MariaDB database
#   /data/redis/        → Redis cache
#   /data/meilisearch/  → Search index
#   /data/logs/         → Supervisor logs
# Default: ./data
# For persistent storage:
#   DATA_PATH=/mnt/user/appdata/newznab/data
#   DATA_PATH=/var/lib/newznab-tmux/data
DATA_PATH=./data

# Web interface port
WEB_PORT=8080

# PHP configuration
PHP_MEMORY_LIMIT=2048M
PHP_MAX_EXECUTION_TIME=300

# Meilisearch API key (auto-generated if not set, but can be pre-configured)
MEILISEARCH_KEY=changeme
