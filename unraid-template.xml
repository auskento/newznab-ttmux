<?xml version="1.0" encoding="utf-8"?>
<Container version="2">
  <Name>newznab-tmux</Name>
  <Repository>nntmux/newznab-tmux:latest</Repository>
  <Registry>https://hub.docker.com</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/NNTmux/newznab-tmux</Support>
  <Project>https://github.com/NNTmux/newznab-tmux</Project>
  <Category>Usenet:Indexer</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/NNTmux/newznab-tmux/master/docker/unraid-template.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/NNTmux/newznab-tmux/master/public/images/logo.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <DonateText>Support the Newznab-tmux project</DonateText>
  <DonateLink>https://github.com/NNTmux/newznab-tmux</DonateLink>
  <Description>
    Newznab-tmux is a modern Usenet indexer built on Laravel. It automatically scans Usenet, organizes headers into searchable releases, and provides API access alongside a web-based interface.
  </Description>
  <Networking>
    <Mode>bridge</Mode>
    <Publish>
      <Port>
        <HostPort>8080</HostPort>
        <ContainerPort>80</ContainerPort>
        <Protocol>tcp</Protocol>
      </Port>
      <Port>
        <HostPort>9000</HostPort>
        <ContainerPort>9000</ContainerPort>
        <Protocol>tcp</Protocol>
      </Port>
    </Publish>
  </Networking>
  <Data>
    <Volume>
      <HostDir>/mnt/user/appdata/newznab</HostDir>
      <ContainerDir>/var/www/newznab/storage</ContainerDir>
      <Mode>rw</Mode>
    </Volume>
    <Volume>
      <HostDir>/mnt/user/appdata/newznab/config</HostDir>
      <ContainerDir>/var/www/newznab/config</ContainerDir>
      <Mode>rw</Mode>
    </Volume>
    <Volume>
      <HostDir>/mnt/user/appdata/newznab/nzbs</HostDir>
      <ContainerDir>/var/www/newznab/storage/nzbs</ContainerDir>
      <Mode>rw</Mode>
    </Volume>
  </Data>
  <Environment>
    <Variable>
      <Name>APP_NAME</Name>
      <Value>Newznab-tmux</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>APP_ENV</Name>
      <Value>production</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>APP_DEBUG</Name>
      <Value>false</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>APP_URL</Name>
      <Value>http://localhost:8080</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>DB_CONNECTION</Name>
      <Value>mysql</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>DB_HOST</Name>
      <Value>newznab-db</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>DB_PORT</Name>
      <Value>3306</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>DB_DATABASE</Name>
      <Value>newznab</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>DB_USERNAME</Name>
      <Value>newznab</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>DB_PASSWORD</Name>
      <Value>changeme</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>REDIS_HOST</Name>
      <Value>newznab-redis</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>REDIS_PORT</Name>
      <Value>6379</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>CACHE_DRIVER</Name>
      <Value>redis</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>QUEUE_CONNECTION</Name>
      <Value>redis</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>SEARCH_ENGINE</Name>
      <Value>meilisearch</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>MEILISEARCH_HOST</Name>
      <Value>http://newznab-meilisearch:7700</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>MEILISEARCH_KEY</Name>
      <Value>changeme</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>PHP_MEMORY_LIMIT</Name>
      <Value>512M</Value>
      <Mode/>
    </Variable>
  </Environment>
</Container>
