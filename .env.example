# Application Configuration
APP_NAME="Newznab-tmux"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_KEY=

# Web Server Port
WEB_PORT=8080

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=newznab-db
DB_PORT=3306
DB_ROOT_PASSWORD=rootpassword
DB_DATABASE=newznab
DB_USERNAME=newznab
DB_PASSWORD=newznabpassword

# Redis Configuration
REDIS_HOST=newznab-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Cache and Queue
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis

# Search Engine (meilisearch or elasticsearch)
SEARCH_ENGINE=meilisearch
MEILISEARCH_HOST=http://newznab-meilisearch:7700
MEILISEARCH_KEY=changeme

# OMDB API Key (optional, for movie/TV data)
OMDB_API_KEY=

# TMDB API Key (optional)
TMDB_API_KEY=

# TVDB API Key (optional)
TVDB_API_KEY=

# TVMaze API (free tier)
TVMAZE_API_KEY=

# Trakt API Key (optional)
TRAKT_API_KEY=

# Mail Configuration
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@newznab.example
MAIL_FROM_NAME="${APP_NAME}"

# PHP Settings
PHP_MEMORY_LIMIT=512M
PHP_MAX_EXECUTION_TIME=300

# Logging
LOG_CHANNEL=stack
